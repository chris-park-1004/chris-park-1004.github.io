---
import Default from '../../../layouts/Default.astro';
import LivePipeline from '../../../components/LivePipeline.astro';
import ContactCard from '../../../components/ContactCard.astro';

const breadcrumbs = [
  { label: 'chris-park-1004', href: '/' },
  { label: 'projects/ci-cd' },
];

interface Component {
  id: string;
  name: string;
  href: string;
  status: 'deployed' | 'planning';
  accent: string;
  sub: string;
  subPages?: string[];
  shots?: { img: string; cap: string }[];
  meta?: string;
}

const components: Component[] = [
  {
    id: 'component_01',
    name: 'Jenkins',
    href: '/projects/ci-cd/jenkins/',
    status: 'deployed',
    accent: 'green',
    sub: 'CI/CD orchestrator · Multibranch Pipeline · controller + windows-agent',
    subPages: ['installation', 'service-account', 'multibranch-pipeline', 'checks-api', 'agents'],
    meta: '5 docs',
  },
  {
    id: 'component_02',
    name: 'GitHub',
    href: '/projects/ci-cd/github/',
    status: 'deployed',
    accent: 'blue',
    sub: 'App-based auth · webhook builds · rich PR status via Checks API',
    subPages: ['app-setup', 'webhook', 'pr-checks'],
    meta: '3 docs',
  },
  {
    id: 'component_03',
    name: 'Cloudflare',
    href: '/projects/ci-cd/cloudflare/',
    status: 'deployed',
    accent: 'yellow',
    sub: 'Outbound-only tunnel · Access gate for admin · zero inbound ports',
    subPages: ['tunnel-setup', 'access-gate'],
    meta: '2 docs',
  },
  {
    id: 'component_04',
    name: 'Prometheus',
    href: '/projects/ci-cd/prometheus/',
    status: 'deployed',
    accent: 'red',
    sub: 'Docker on Jenkins host · 120s scrape · remote_write → Grafana Cloud Mimir',
    meta: 'metric catalog',
  },
  {
    id: 'component_05',
    name: 'Grafana',
    href: '/projects/ci-cd/grafana/',
    status: 'deployed',
    accent: 'purple',
    sub: 'Grafana Cloud free tier · public dashboard · 2 row groups',
    shots: [
      { img: '/img/grafana/jenkins-overview.png', cap: 'jenkins-overview' },
      { img: '/img/grafana/server-resources.png', cap: 'server-resources' },
    ],
    meta: '2 row groups',
  },
];

---

<Default
  title="CI/CD Pipeline — Chris (Honggyu) Park"
  description="Personal CI/CD pipeline project: Jenkins on home PC, Cloudflare Tunnel, GitHub App authentication, Prometheus metrics and a live public Grafana dashboard."
  breadcrumbs={breadcrumbs}
>

  <!-- header -->
  <div class="header" style="margin-bottom: 20px;">
    <div>
      <div class="prompt">$ cat README.md</div>
      <h1>CI/CD Pipeline</h1>
      <div class="subtitle">Self-hosted Jenkins on home PC · GitHub App auth · Cloudflare Tunnel + Access</div>
    </div>
    <div class="header-meta">
      <div class="row">stack: <b>5 components</b></div>
      <div class="row">status: <b style="color:var(--green)">● deployed</b></div>
    </div>
  </div>

  <!-- live pipeline -->
  <LivePipeline />

  <!-- main grid -->
  <div class="grid">
    <div>

      <div class="section-label">── ./components</div>

      {components.map((comp) => (
        <a href={comp.href} class="stage-link" style="display: block; margin-bottom: 14px;">
          <div class="stage" style={`--accent: var(--${comp.accent})${comp.shots ? '; overflow: hidden' : ''}`}>
            <div class="stage-head">
              <div>
                <div class="stage-meta">
                  <span class="id">{comp.id}</span>
                  {comp.status === 'deployed' ? (
                    <span class="badge b-green"><span class="badge-dot"></span>deployed</span>
                  ) : (
                    <span class="badge b-dim"><span class="badge-dot"></span>planning</span>
                  )}
                </div>
                <div class="stage-name">{comp.name}</div>
                <div class="stage-sub">{comp.sub}</div>
              </div>
              <div class="stage-dur">{comp.meta}</div>
            </div>
            {(comp.subPages || comp.shots) && (
              <div class="stage-body">
                {comp.subPages && (
                  <div class="stack-tags">
                    {comp.subPages.map((sub) => (
                      <span class="chip">{sub}</span>
                    ))}
                  </div>
                )}
                {comp.shots && (
                  <div class="shot-grid">
                    {comp.shots.map((s) => (
                      <div class="shot">
                        <img src={s.img} alt={`Grafana — ${s.cap} row group`} loading="lazy" />
                        <div class="shot-cap">{s.cap}</div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </div>
        </a>
      ))}

    </div>

    <!-- right rail -->
    <div class="rail">

      <div class="section-label">── ./contact</div>
      <ContactCard />

      <div class="section-label">── ./architecture</div>

      <div class="card stack-card">
        <div class="stack-group">
          <div class="cat">CI</div>
          <div class="stack-tags">
            <span class="stack-tag">Jenkins LTS</span>
            <span class="stack-tag">Java 25</span>
            <span class="stack-tag">Groovy</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Auth & Network</div>
          <div class="stack-tags">
            <span class="stack-tag">GitHub App</span>
            <span class="stack-tag">JWT (RS256)</span>
            <span class="stack-tag">Cloudflare Tunnel</span>
            <span class="stack-tag">Cloudflare Access</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Observability</div>
          <div class="stack-tags">
            <span class="stack-tag">Prometheus</span>
            <span class="stack-tag">Grafana Cloud</span>
          </div>
        </div>
      </div>

    </div>
  </div>

</Default>

<style>
  /* Grafana card thumbnails run slightly taller here than on the dashboard */
  .shot img { height: 120px; }

  /* entrance stagger (design: CI-CD Pipeline v2) */
  .grid > div:first-child .stage { animation: nodepop .5s both; }
  .grid > div:first-child .stage-link:nth-of-type(1) .stage { animation-delay: .1s; }
  .grid > div:first-child .stage-link:nth-of-type(2) .stage { animation-delay: .2s; }
  .grid > div:first-child .stage-link:nth-of-type(3) .stage { animation-delay: .3s; }
  .grid > div:first-child .stage-link:nth-of-type(4) .stage { animation-delay: .4s; }
  .grid > div:first-child .stage-link:nth-of-type(5) .stage { animation-delay: .5s; }
</style>
