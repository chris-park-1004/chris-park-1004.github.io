---
import Default from '../layouts/Default.astro';
import CareerHighlights from '../components/CareerHighlights.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import ContactCard from '../components/ContactCard.astro';

const breadcrumbs = [
  { label: 'chris-park-1004' },
];
---

<Default
  title="Chris (Honggyu) Park — DevOps Portfolio"
  description="Personal DevOps portfolio. Career timeline + hands-on CI/CD project documentation."
  breadcrumbs={breadcrumbs}
>

  <!-- header -->
  <div class="header" style="margin-bottom: 20px;">
    <div>
      <div class="prompt">$ whoami</div>
      <h1>Chris Park <span style="font-weight:400;color:var(--text-dim);font-size:0.5em;letter-spacing:-0.3px;">/ DevOps Engineer</span></h1>
      <div class="subtitle">I build and run CI/CD pipelines end to end — Waterloo, ON · <span style="color:var(--green)">● open to work</span></div>
    </div>
  </div>

  <CareerHighlights />

  <!-- main grid -->
  <div class="grid">
    <div>

      <!-- ABOUT ME -->
      <div class="section-label">── about me</div>

      <a href="/career" class="stage-link">
        <div class="stage" id="about-card" style="--accent: var(--purple)">
          <div class="stage-head">
            <div>
              <div class="stage-meta">
                <span class="id">profile_01</span>
                <span class="badge b-green"><span class="badge-dot"></span>active</span>
              </div>
              <div class="stage-name">Mech-Eng turned DevOps Engineer</div>
              <div class="stage-sub">Jenkins · Azure DevOps · Docker · SonarQube · GitHub Actions</div>
            </div>
            <div class="stage-dur">since 2023</div>
          </div>
          <div class="stage-body">
            <div class="cta">view full career timeline →</div>
          </div>
        </div>
      </a>

      <!-- ABOUT MY PROJECTS -->
      <div class="section-label" style="margin-top: 28px;">── about my projects</div>

      <a href="/projects/ci-cd/" class="stage-link">
        <div class="stage" style="--accent: var(--green); overflow: hidden;">
          <div class="stage-head">
            <div>
              <div class="stage-meta">
                <span class="id">project_01</span>
                <span class="badge b-green"><span class="badge-dot"></span>deployed</span>
              </div>
              <div class="stage-name">CI/CD Pipeline</div>
              <div class="stage-sub">Self-hosted Jenkins · Cloudflare Tunnel · GitHub App · Prometheus + Grafana</div>
            </div>
            <div class="stage-dur">5 components</div>
          </div>
          <div class="stage-body">
            <div class="shot-grid">
              <div class="shot">
                <img src="/img/grafana/jenkins-overview.png" alt="Grafana — Jenkins overview dashboard" loading="lazy" />
                <div class="shot-cap">jenkins-overview · live</div>
              </div>
              <div class="shot">
                <img src="/img/grafana/server-resources.png" alt="Grafana — server resources dashboard" loading="lazy" />
                <div class="shot-cap">server-resources · live</div>
              </div>
            </div>
            <div class="cta" style="margin-top: 12px;">view project →</div>
          </div>
        </div>
      </a>

    </div>

    <!-- right rail -->
    <div class="rail">
      <div class="section-label">── contact</div>

      <ContactCard id="contact-card" />

      <div class="section-label">── career overview</div>
      <CareerTimeline />
    </div>
  </div>

</Default>

<style>
  /* Page-local only — these selectors are shared with other pages,
     so they must stay scoped here instead of moving into global.css:
       .stage-link        → also used by the ci-cd component index pages
       .endpoints-card    → also used by /career */
  .stage-link {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: transform .15s, border-color .15s;
  }
  .stage-link:hover .stage {
    border-color: var(--text-faint);
    transform: translateY(-1px);
  }

  /* stretch the contact card to the About card height (ink look + entrance are global) */
  .rail :global(.endpoints-card) {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* entrance stagger — highlights run .1–.4s, so the two main cards follow at .5/.6s */
  .grid > div:first-child .stage { animation: nodepop .5s both; }
  .grid > div:first-child .stage-link:nth-of-type(1) .stage { animation-delay: .5s; }
  .grid > div:first-child .stage-link:nth-of-type(2) .stage { animation-delay: .6s; }
</style>

<script is:inline>
  // Match the contact card height to the About card (desktop two-column layout only)
  (function () {
    const about = document.getElementById('about-card');
    const contact = document.getElementById('contact-card');
    if (!about || !contact) return;

    function sync() {
      if (window.innerWidth <= 900) {
        contact.style.minHeight = '';
        return;
      }
      // min-height (not height) so the card can still grow if its content overflows
      contact.style.minHeight = about.offsetHeight + 'px';
    }

    window.addEventListener('resize', sync);
    requestAnimationFrame(sync);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sync);
  })();
</script>
