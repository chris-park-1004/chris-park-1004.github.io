---
import Default from '../layouts/Default.astro';
import CareerHighlights from '../components/CareerHighlights.astro';
import ContactCard from '../components/ContactCard.astro';

const breadcrumbs = [
  { label: 'chris-park-1004', href: '/' },
  { label: 'career' },
];
---

<Default
  title="Career — Chris (Honggyu) Park"
  description="Chris (Honggyu) Park — DevOps Engineer based in Waterloo, ON. Mechanical-engineer turned software, building CI/CD pipelines on Azure."
  breadcrumbs={breadcrumbs}
>

  <!-- header -->
  <div class="header" style="margin-bottom: 20px;">
    <div>
      <div class="prompt">$ kubectl describe engineer/chris-park</div>
      <h1>Chris Park <span style="font-weight:400;color:var(--text-dim);font-size:0.5em;letter-spacing:-0.3px;">/ Honggyu</span></h1>
      <div class="subtitle">DevOps Engineer · Mech-Eng turned Software · Waterloo, ON</div>
    </div>
    <div class="header-meta">
      <div class="row">since: <b>2023-09</b></div>
      <div class="row">region: <b>canadacentral</b></div>
      <div class="row">status: <b style="color:var(--green)">● open to work</b></div>
    </div>
  </div>

  <CareerHighlights />

  <!-- main grid -->
  <div class="grid">
    <div>
      <div class="section-label">── career.pipeline.yml</div>

      <div class="stage" style="--accent: var(--purple)">
        <div class="stage-head">
          <div>
            <div class="stage-meta">
              <span class="id">stage_01</span>
              <span class="badge b-green"><span class="badge-dot"></span>success</span>
            </div>
            <div class="stage-name">B.Eng — Mechanical Engineering</div>
            <div class="stage-sub">Jeonju University · 2015–2022</div>
          </div>
          <div class="stage-dur">7y</div>
        </div>
        <div class="stage-body">
          <ul>
            <li><span class="check" style="color:var(--green)">✓</span><span>Capstone — energy-recovery generator harvesting excess pressure in apartment water supply</span></li>
            <li><span class="check" style="color:var(--green)">✓</span><span>1st place, graduation capstone design competition</span></li>
          </ul>
        </div>
      </div>
      <div class="edge" style="color:var(--purple);padding:10px 0;">
        <svg aria-hidden="true" width="20" height="28" viewBox="0 0 20 28"><line x1="10" y1="0" x2="10" y2="22" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" style="animation:edgeflow 1s linear infinite;"/><path d="M5 18 L10 26 L15 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
      </div>

      <div class="stage" style="--accent: var(--green)">
        <div class="stage-head">
          <div>
            <div class="stage-meta">
              <span class="id">stage_02</span>
              <span class="badge b-green"><span class="badge-dot"></span>success</span>
            </div>
            <div class="stage-name">DevOps Engineer @ VARLab</div>
            <div class="stage-sub">Conestoga College · May 2024 – May 2025</div>
          </div>
          <div class="stage-dur">12mo</div>
        </div>
        <div class="stage-body">
          <ul>
            <li><span class="check" style="color:var(--green)">✓</span><span>First automated CI/CD pipelines for JS + Unity projects</span></li>
            <li><span class="check" style="color:var(--green)">✓</span><span>Docker + Azure Container Registry / Container Apps</span></li>
            <li><span class="check" style="color:var(--green)">✓</span><span>Windows → Linux migration · SonarQube + team guidelines</span></li>
          </ul>
        </div>
      </div>
      <div class="edge" style="color:var(--purple);padding:10px 0;">
        <svg aria-hidden="true" width="20" height="28" viewBox="0 0 20 28"><line x1="10" y1="0" x2="10" y2="22" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" style="animation:edgeflow 1s linear infinite;"/><path d="M5 18 L10 26 L15 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
      </div>

      <div class="stage" style="--accent: var(--blue)">
        <div class="stage-head">
          <div>
            <div class="stage-meta">
              <span class="id">stage_03</span>
              <span class="badge b-green"><span class="badge-dot"></span>success</span>
            </div>
            <div class="stage-name">Software Engineer @ Smart Centre</div>
            <div class="stage-sub">Conestoga College · May – Sep 2025</div>
          </div>
          <div class="stage-dur">5mo</div>
        </div>
        <div class="stage-body">
          <ul>
            <li><span class="check" style="color:var(--green)">✓</span><span>Full-stack app — React + Express.js REST APIs · Google OAuth 2.0 · Gemini API</span></li>
            <li><span class="check" style="color:var(--green)">✓</span><span>C# Unity VR from industrial machine scans · 3D assets via Blender</span></li>
          </ul>
        </div>
      </div>
      <div class="edge" style="color:var(--purple);padding:10px 0;">
        <svg aria-hidden="true" width="20" height="28" viewBox="0 0 20 28"><line x1="10" y1="0" x2="10" y2="22" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" style="animation:edgeflow 1s linear infinite;"/><path d="M5 18 L10 26 L15 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
      </div>

      <div class="stage" style="--accent: var(--green)">
        <div class="stage-head">
          <div>
            <div class="stage-meta">
              <span class="id">stage_04</span>
              <span class="badge b-green"><span class="badge-dot"></span>success</span>
            </div>
            <div class="stage-name">Adv. Diploma — Software Engineering Tech.</div>
            <div class="stage-sub">Conestoga College · 2023 – 2026</div>
          </div>
          <div class="stage-dur">3y</div>
        </div>
        <div class="stage-body">
          <ul>
            <li><span class="check" style="color:var(--green)">✓</span><span>Capstone <a href="https://setprojectday.ca/post/2026/loc8u/" target="_blank" rel="noopener" style="color:var(--purple);font-weight:600;">LOC8U</a> — LoRa safety net for visitors in remote areas: geofence alerts, SOS beacons, live position tracking</span></li>
            <li><span class="check" style="color:var(--green)">✓</span><span>Built the Python server bridging LoRa IoT devices ↔ client via Apache Kafka</span></li>
          </ul>
        </div>
      </div>
      <div class="edge" style="color:var(--purple);padding:10px 0;">
        <svg aria-hidden="true" width="20" height="28" viewBox="0 0 20 28"><line x1="10" y1="0" x2="10" y2="22" stroke="currentColor" stroke-width="2" stroke-dasharray="6 6" style="animation:edgeflow 1s linear infinite;"/><path d="M5 18 L10 26 L15 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
      </div>

      <div class="stage" style="--accent: var(--blue)">
        <div class="stage-head">
          <div>
            <div class="stage-meta">
              <span class="id">stage_05</span>
              <span class="badge b-blue"><span class="badge-dot"></span>running</span>
            </div>
            <div class="stage-name">Next: Full-Time DevOps / SRE</div>
            <div class="stage-sub">Open to opportunities · Canada · Remote</div>
          </div>
          <div class="stage-dur">in progress</div>
        </div>
        <div class="stage-body">
          <p style="font-style: italic;">Deployment in progress · accepting offers ▶</p>
        </div>
      </div>
    </div>

    <!-- right rail -->
    <div class="rail">
      <div class="section-label">── ./contact</div>
      <ContactCard />

      <div class="section-label">── ./skills</div>
      <div class="card stack-card">
        <div class="stack-group">
          <div class="cat">CI/CD</div>
          <div class="stack-tags">
            <span class="stack-tag">Jenkins</span>
            <span class="stack-tag">GitHub Actions</span>
            <span class="stack-tag">Bitbucket</span>
            <span class="stack-tag">Azure DevOps</span>
            <span class="stack-tag">SonarQube</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Cloud / Infra</div>
          <div class="stack-tags">
            <span class="stack-tag">Azure</span>
            <span class="stack-tag">Docker</span>
            <span class="stack-tag">Container Apps</span>
            <span class="stack-tag">Linux</span>
            <span class="stack-tag">Nginx</span>
            <span class="stack-tag">Apache</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Languages</div>
          <div class="stack-tags">
            <span class="stack-tag">JavaScript</span>
            <span class="stack-tag">TypeScript</span>
            <span class="stack-tag">C#</span>
            <span class="stack-tag">Python</span>
            <span class="stack-tag">C++</span>
            <span class="stack-tag">C</span>
            <span class="stack-tag">Groovy</span>
            <span class="stack-tag">Bash</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Web</div>
          <div class="stack-tags">
            <span class="stack-tag">React</span>
            <span class="stack-tag">Next.js</span>
            <span class="stack-tag">Node.js</span>
            <span class="stack-tag">Express.js</span>
            <span class="stack-tag">NestJS</span>
            <span class="stack-tag">REST APIs</span>
            <span class="stack-tag">OAuth 2.0</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Data</div>
          <div class="stack-tags">
            <span class="stack-tag">PostgreSQL</span>
            <span class="stack-tag">MySQL</span>
            <span class="stack-tag">MongoDB</span>
            <span class="stack-tag">SQL Server</span>
            <span class="stack-tag">Supabase</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Testing</div>
          <div class="stack-tags">
            <span class="stack-tag">Jest</span>
            <span class="stack-tag">Vitest</span>
            <span class="stack-tag">PyTest</span>
            <span class="stack-tag">NUnit</span>
          </div>
        </div>
        <div class="stack-group">
          <div class="cat">Concepts</div>
          <div class="stack-tags">
            <span class="stack-tag">OOP</span>
            <span class="stack-tag">DSA</span>
            <span class="stack-tag">HTTP</span>
            <span class="stack-tag">TLS/SSL</span>
            <span class="stack-tag">Distributed Systems</span>
            <span class="stack-tag">Git</span>
            <span class="stack-tag">Agile</span>
          </div>
        </div>
      </div>
    </div>
  </div>

</Default>

<style>
  /* entrance stagger (design: Career v2) — column children alternate stage/edge */
  .grid > div:first-child > .stage,
  .grid > div:first-child > .edge { animation: nodepop .5s both; }
  .grid > div:first-child > :nth-child(2)  { animation-delay: .05s; }
  .grid > div:first-child > :nth-child(3)  { animation-delay: .12s; }
  .grid > div:first-child > :nth-child(4)  { animation-delay: .2s; }
  .grid > div:first-child > :nth-child(5)  { animation-delay: .27s; }
  .grid > div:first-child > :nth-child(6)  { animation-delay: .35s; }
  .grid > div:first-child > :nth-child(7)  { animation-delay: .42s; }
  .grid > div:first-child > :nth-child(8)  { animation-delay: .5s; }
  .grid > div:first-child > :nth-child(9)  { animation-delay: .57s; }
  .grid > div:first-child > :nth-child(10) { animation-delay: .65s; }
</style>
