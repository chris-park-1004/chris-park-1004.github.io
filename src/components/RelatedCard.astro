---
export interface RelatedLink {
  href: string;
  label: string;
  /** CSS colour variable name without the `--` prefix; defaults to `text-dim` */
  color?: string;
}

interface Props {
  links: RelatedLink[];
}

const { links } = Astro.props;
---

<div class="card">
  <div class="card-label">related</div>
  <div class="related-links">
    {links.map((l) => (
      <a href={l.href} style={`color: var(--${l.color ?? 'text-dim'});`}>{l.label}</a>
    ))}
  </div>
</div>
