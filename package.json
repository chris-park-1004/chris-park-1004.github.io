{
  "name": "chris-park-1004.github.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 5173",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "npm run typecheck && react-router build && npm run verify",
    "verify": "node scripts/verify-site.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --outDir build/client"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.3",
    "parse5": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
